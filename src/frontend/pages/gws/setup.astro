---
/**
 * `/gws/setup` — deployment docs. Static content; every command here is the
 * real command for this repo (see `wrangler.jsonc`, `.dev.vars.example`,
 * `package.json` scripts, and `src/backend/api/routes/auth-google.ts`).
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Badge } from "@/components/ui/badge";
import { CodeBlock } from "@/components/ui/code-block";

const secretsCmd = `npx wrangler secret put GOOGLE_CLIENT_ID
npx wrangler secret put GOOGLE_CLIENT_SECRET`;

const wranglerVars = `// wrangler.jsonc
"vars": {
  "PUBLIC_BASE_URL": "https://<worker>.<subdomain>.workers.dev",
},
"kv_namespaces": [
  { "binding": "SESSIONS", "id": "…" },
],
"d1_databases": [
  { "binding": "DB", "database_name": "…", "database_id": "…" },
],`;

const migrateCmd = `pnpm run migrate:remote`;
const deployCmd = `pnpm run deploy`;

const devVars = `# .dev.vars (copy from .dev.vars.example, gitignored, never commit real values)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_BASE_URL=http://localhost:8787`;

const mcpClientConfig = `{
  "mcpServers": {
    "google-workspace": {
      "url": "https://<worker>.<subdomain>.workers.dev/mcp",
      "headers": { "Authorization": "Bearer <cr_session cookie value>" }
    }
  }
}`;

const steps = [
  {
    n: 1,
    title: "Create the Google OAuth client",
    body: "In Google Cloud Console → APIs & Services → Credentials, create (or confirm) an OAuth 2.0 client of type “Web application”. Add this authorized redirect URI, replacing <worker> with your deployed Worker's hostname:",
    code: { lang: "text", file: "redirect URI", src: "https://<worker>/auth/google/callback" },
  },
  {
    n: 2,
    title: "Set the OAuth secrets",
    body: "Take the client ID and client secret from the credentials JSON Google gives you, and push them as Worker secrets (never committed):",
    code: { lang: "bash", file: "terminal", src: secretsCmd },
  },
  {
    n: 3,
    title: "Point PUBLIC_BASE_URL at the deployed Worker",
    body: "wrangler.jsonc already declares the SESSIONS KV namespace and the DB D1 database this project uses — set PUBLIC_BASE_URL to your Worker's public URL so the OAuth redirect_uri is built correctly:",
    code: { lang: "jsonc", file: "wrangler.jsonc", src: wranglerVars },
  },
  {
    n: 4,
    title: "Apply D1 migrations",
    body: "Generates the latest Drizzle migration and applies it to the remote D1 database bound as DB:",
    code: { lang: "bash", file: "terminal", src: migrateCmd },
  },
  {
    n: 5,
    title: "Deploy",
    body: "Builds the Astro + Worker bundle, applies migrations, and deploys with wrangler:",
    code: { lang: "bash", file: "terminal", src: deployCmd },
  },
  {
    n: 6,
    title: "Sign in and connect an MCP client",
    body: "Visit /auth/google on the deployed Worker to sign in with Google. That sets a cr_session cookie — copy its value and use it as a Bearer token when connecting any MCP client to /mcp:",
    code: { lang: "json", file: "mcp client config", src: mcpClientConfig },
  },
];
---

<BaseLayout
  title="Setup & Deploy"
  description="Deploy the Google Workspace MCP Worker: OAuth client, secrets, KV/D1 bindings, and connecting an MCP client"
>
  <div class="container mx-auto max-w-4xl px-4 py-16">

    <section class="mb-12 space-y-4">
      <Badge variant="outline" class="font-mono text-[11px]">Setup</Badge>
      <h1 class="text-balance text-4xl font-bold tracking-tight">Setup &amp; Deploy</h1>
      <p class="max-w-2xl text-base leading-relaxed text-muted-foreground">
        This is a stateless, multi-user Worker: every signed-in Google account gets its own
        refresh token in KV, keyed by the Google <code class="text-primary">sub</code> claim, so
        one deployment serves many users without any shared credentials.
      </p>
    </section>

    <section class="mb-12 space-y-3">
      <h2 class="text-xl font-bold">Local development</h2>
      <p class="text-sm text-muted-foreground">
        Copy <code class="text-primary">.dev.vars.example</code> to <code class="text-primary">.dev.vars</code> and fill in your OAuth client credentials for <code class="text-primary">wrangler dev</code>:
      </p>
      <CodeBlock client:visible filename=".dev.vars" language="bash" code={devVars} />
    </section>

    <section class="space-y-10">
      {steps.map((step) => (
        <div class="space-y-3">
          <div class="flex items-center gap-3">
            <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-primary text-sm font-semibold text-primary-foreground">{step.n}</span>
            <h2 class="text-xl font-bold">{step.title}</h2>
          </div>
          <p class="pl-10 text-sm text-muted-foreground">{step.body}</p>
          <div class="pl-10">
            <CodeBlock client:visible filename={step.code.file} language={step.code.lang} code={step.code.src} />
          </div>
        </div>
      ))}
    </section>

  </div>
</BaseLayout>
